  <diagram name="Halaman-1" id="qg2COM-68cg7EUS-y4hS">
    <mxGraphModel dx="1229" dy="2427" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1800" math="0" shadow="0">
