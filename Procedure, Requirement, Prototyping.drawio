  <diagram name="Halaman-1" id="qg2COM-68cg7EUS-y4hS">
    <mxGraphModel dx="1012" dy="2316" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2ty-PPOI9Jx8jDVx18oE-11" edge="1" parent="1" source="2ty-PPOI9Jx8jDVx18oE-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="2ty-PPOI9Jx8jDVx18oE-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2ty-PPOI9Jx8jDVx18oE-13" edge="1" parent="1" source="2ty-PPOI9Jx8jDVx18oE-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="2ty-PPOI9Jx8jDVx18oE-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2ty-PPOI9Jx8jDVx18oE-4" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;strokeWidth=2;fillColor=default;strokeColor=default;" value="&lt;b&gt;Step by step Project:&lt;/b&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Mempelajari dan memahami struktur data, tipe data, dan atribut yang akan digunakan sesuai dengan requirement.&lt;/li&gt;&lt;li&gt;Ambil atribut dari dataset yang akan digunakan untuk membuat dashboard. Bagi dalam Empat dataset berdasarkan kategori dataset &lt;b&gt;Penjualan, Produk&amp;amp;Vendor, Pelanggan&amp;amp;wilayah, dan Status Operasional&lt;/b&gt;. Gunakan SQL agar komputer tidak crash ketika melakukan render data yang sangat besar.&lt;/li&gt;&lt;li&gt;Melakukan pembersihan data masing-masing tiap dataset dari missing value, double data, inkonsistensi data, dsb. Gunakan python agar proses lebih efisien.&lt;/li&gt;&lt;li&gt;Pastikan data sudah benar-benar bersih dan siap digunakan.&lt;/li&gt;&lt;li&gt;Membuat prototype dashboard menggunakan draw.Io&lt;/li&gt;&lt;li&gt;Membuat dashboard menggunakan google data studio agar data terintegrasi ketika dilakukan perubahan pada dataset.&lt;/li&gt;&lt;li&gt;Mengamati dan melakukan analisa mendalam.&lt;/li&gt;&lt;li&gt;Membuat rekomendasi keputusan bisnis&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="430" x="10" y="-1720" as="geometry" />
        </mxCell>
        <mxCell id="2ty-PPOI9Jx8jDVx18oE-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=default;align=left;verticalAlign=middle;rounded=0;strokeWidth=1;" value="1.&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Pertanyaan Bisnis:&lt;/span&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Berapa banyak produk yang berhasil terjual, dan produk/kategori apa saja yang paling laris?&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Bagaimana tren pendapatan dan jumlah pelanggan dari tahun ke tahun (2020–2025)?&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Metode pembayaran apa yang paling banyak digunakan, dan bagaimana pergeserannya dari waktu ke waktu?&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Seberapa besar tingkat data yang bermasalah (missing value, duplikat, outlier) dalam sistem transaksi perusahaan saat ini?&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Apa rekomendasi perbaikan proses input data agar masalah kualitas data ini tidak terus berulang?&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="361" x="440" y="-1440" as="geometry" />
        </mxCell>
        <mxCell id="2ty-PPOI9Jx8jDVx18oE-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=default;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: left;&quot;&gt;2. Atribut yang akan digunakan:&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ol&gt;&lt;li&gt;transactionID&lt;/li&gt;&lt;li&gt;orderdate&lt;/li&gt;&lt;li&gt;Productname&lt;/li&gt;&lt;li&gt;Category&lt;/li&gt;&lt;li&gt;Brand&lt;/li&gt;&lt;li&gt;Unit Price&lt;/li&gt;&lt;li&gt;Quantity&lt;/li&gt;&lt;li&gt;DiscountPct&lt;/li&gt;&lt;li&gt;discountAmount&lt;/li&gt;&lt;li&gt;taxamount&lt;/li&gt;&lt;li&gt;Age&lt;/li&gt;&lt;li&gt;Gender&lt;/li&gt;&lt;li&gt;Review Rating&lt;/li&gt;&lt;li&gt;paymentmethod&lt;/li&gt;&lt;li&gt;paymentstatus&lt;/li&gt;&lt;li&gt;orderstatus&lt;/li&gt;&lt;li&gt;supplierName&lt;/li&gt;&lt;li&gt;City&lt;/li&gt;&lt;li&gt;country.&lt;/li&gt;&lt;li&gt;currency&lt;/li&gt;&lt;li&gt;Total Amount&lt;/li&gt;&lt;li&gt;ReturnFlag&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="324" x="440" y="-1160" as="geometry" />
        </mxCell>
      </root>
